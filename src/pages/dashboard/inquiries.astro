---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import type { ContactInquiry } from "@/types";

const NEEDS_PREVIEW_LENGTH = 140;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

let hasProfile = false;
let inquiries: ContactInquiry[] = [];

if (supabase && user) {
  const { data: profile } = await supabase.from("decorator_profiles").select("id").eq("user_id", user.id).maybeSingle();

  if (profile) {
    hasProfile = true;
    const { data } = await supabase
      .from("contact_inquiries")
      .select("*")
      .eq("decorator_profile_id", profile.id)
      .order("created_at", { ascending: false })
      .limit(50);

    inquiries = (data ?? []) as ContactInquiry[];
  }
}

function formatDate(value: string): string {
  return new Date(value).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
}

function truncate(text: string, max: number): string {
  return text.length > max ? `${text.slice(0, max).trimEnd()}…` : text;
}
---

<DashboardLayout title="Inquiries">
  <div class="space-y-6">
    <div>
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Inquiries
      </h1>
      <p class="mt-2 text-sm text-blue-100/70">Contact requests from clients who found you on EventBook.</p>
      <a href="/dashboard" class="mt-2 inline-block text-sm text-purple-300 hover:underline">Back to panel</a>
    </div>

    {
      !hasProfile ? (
        <section class="rounded-2xl border border-amber-400/30 bg-amber-500/10 p-6">
          <h2 class="text-lg font-semibold text-amber-100">Complete your profile first</h2>
          <p class="mt-2 text-sm text-amber-100/80">
            Inquiries are linked to your decorator profile. Create a profile, then come back here.
          </p>
          <a
            href="/dashboard/profile"
            class="mt-4 inline-flex rounded-lg bg-amber-400/20 px-4 py-2 text-sm font-medium text-amber-50 hover:bg-amber-400/30"
          >
            Set up profile
          </a>
        </section>
      ) : inquiries.length === 0 ? (
        <p class="rounded-2xl border border-dashed border-white/20 bg-white/5 px-4 py-8 text-center text-sm text-blue-100/70">
          No inquiries yet. Once your profile is published, client requests will show up here.
        </p>
      ) : (
        <ul class="space-y-3">
          {inquiries.map((inquiry) => (
            <li class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="font-medium text-white">{inquiry.client_name}</p>
                  <p class="mt-0.5 text-sm text-blue-100/70">
                    <a class="hover:underline" href={`mailto:${inquiry.client_email}`}>
                      {inquiry.client_email}
                    </a>
                    {inquiry.client_phone && <span> · {inquiry.client_phone}</span>}
                  </p>
                </div>
                <div class="text-right text-xs text-blue-100/50">
                  <p>Event: {formatDate(inquiry.event_date)}</p>
                  <p>Received: {formatDate(inquiry.created_at)}</p>
                </div>
              </div>

              <p class="mt-3 text-sm leading-relaxed whitespace-pre-wrap text-blue-100/80">
                {truncate(inquiry.needs_description, NEEDS_PREVIEW_LENGTH)}
              </p>
              {inquiry.needs_description.length > NEEDS_PREVIEW_LENGTH && (
                <details class="mt-1">
                  <summary class="cursor-pointer text-sm text-purple-300 hover:underline">Show full request</summary>
                  <p class="mt-2 text-sm leading-relaxed whitespace-pre-wrap text-blue-100/80">
                    {inquiry.needs_description}
                  </p>
                </details>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</DashboardLayout>
