---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import PortfolioPanel from "@/components/decorator/PortfolioPanel";
import { createClient } from "@/lib/supabase";
import type { PortfolioEntry } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

let hasProfile = false;
let entries: PortfolioEntry[] = [];

if (supabase && user) {
  const { data: profile } = await supabase.from("decorator_profiles").select("id").eq("user_id", user.id).maybeSingle();

  if (profile) {
    hasProfile = true;
    const { data } = await supabase
      .from("portfolio_entries")
      .select("*")
      .eq("decorator_profile_id", profile.id)
      .order("created_at", { ascending: false });

    entries = (data ?? []) as PortfolioEntry[];
  }
}
---

<DashboardLayout title="Portfolio">
  <div class="space-y-6">
    <div>
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Portfolio
      </h1>
      <p class="mt-2 text-sm text-blue-100/70">Showcase your event decorations. Photos come next.</p>
      <a href="/dashboard" class="mt-2 inline-block text-sm text-purple-300 hover:underline">Back to panel</a>
    </div>

    {
      !hasProfile ? (
        <section class="rounded-2xl border border-amber-400/30 bg-amber-500/10 p-6">
          <h2 class="text-lg font-semibold text-amber-100">Complete your profile first</h2>
          <p class="mt-2 text-sm text-amber-100/80">
            Portfolio entries are linked to your decorator profile. Create a profile, then come back here.
          </p>
          <a
            href="/dashboard/profile"
            class="mt-4 inline-flex rounded-lg bg-amber-400/20 px-4 py-2 text-sm font-medium text-amber-50 hover:bg-amber-400/30"
          >
            Set up profile
          </a>
        </section>
      ) : (
        <PortfolioPanel initialEntries={entries} client:load />
      )
    }
  </div>
</DashboardLayout>
