---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import ProfileForm from "@/components/decorator/ProfileForm";
import { DECORATION_STYLE_OPTIONS, EVENT_TYPE_OPTIONS } from "@/lib/decorator-taxonomy";
import { resolveProfilePhotoUrl } from "@/lib/profile-photo";
import { createClient } from "@/lib/supabase";
import type { DecoratorProfile } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let profile: DecoratorProfile | null = null;

if (supabase) {
  const { user } = Astro.locals;
  if (user) {
    const { data } = await supabase.from("decorator_profiles").select("*").eq("user_id", user.id).maybeSingle();

    if (data) {
      const row = data as DecoratorProfile;
      const displayUrl = await resolveProfilePhotoUrl(supabase, row.profile_photo_url);
      profile = { ...row, profile_photo_url: displayUrl };
    }
  }
}
---

<DashboardLayout title="Profile">
  <div class="space-y-6">
    <div>
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Decorator profile
      </h1>
      <p class="mt-2 text-sm text-blue-100/70">
        {profile ? "Update your public profile and publish settings." : "Create your decorator profile to get started."}
      </p>
      <a href="/dashboard" class="mt-2 inline-block text-sm text-purple-300 hover:underline">Back to panel</a>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
      <ProfileForm
        initialProfile={profile}
        eventTypeOptions={EVENT_TYPE_OPTIONS}
        decorationStyleOptions={DECORATION_STYLE_OPTIONS}
        client:load
      />
    </div>
  </div>
</DashboardLayout>
